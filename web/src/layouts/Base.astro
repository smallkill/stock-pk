<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>台股 PK · Derek Chen</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="台股多檔 PK — 比較最多 5 檔台股的含息報酬。by Derek Chen" />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;800&family=Space+Mono&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet" />
    <style is:global>
      :root{--bg:#faf9f6;--bg-elev:#fff;--ink:#18181b;--ink-soft:#3f3f46;--muted:#6b7280;--line:#e7e4dd;--accent:#2347d6;--accent-soft:#eef1fd;--up:#2f9e44;--down:#e03131;--sans:"Hanken Grotesk","Noto Sans TC",system-ui,sans-serif;--mono:"Space Mono","Noto Sans TC",monospace;}
      *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);line-height:1.6}
      a{color:var(--accent);text-decoration:none}.wrap{max-width:860px;margin:0 auto;padding:0 1.2rem}
      .head{border-bottom:1px solid var(--line);background:var(--bg)}
      .head .row{display:flex;align-items:center;gap:1rem;height:56px}
      .wordmark{font-weight:800;color:var(--ink)}.wordmark .t{color:var(--accent)}
      .head nav{margin-left:auto;font-size:.88rem}
      .foot{border-top:1px solid var(--line);margin-top:4rem;padding:2rem 0;color:var(--muted);font-family:var(--mono);font-size:.76rem}
    </style>
  </head>
  <body>
    <header class="head"><div class="wrap row">
      <a class="wordmark" href="https://derek-chen.pages.dev">Derek Chen<span class="t">.</span></a>
      <nav><a href="https://derek-chen.pages.dev">← 回作品集</a></nav>
    </div></header>
    <main class="wrap"><slot /></main>
    <footer class="foot"><div class="wrap">
      © 2026 Derek Chen · 台股多檔 PK · <a href="https://derek-chen.pages.dev">作品集</a>
      · <span id="uses">—</span> 人用過
    </div></footer>
    <script>
      import { beacon, fetchUses } from "../lib/api";
      beacon();
      fetchUses().then((n) => { if (n != null) document.getElementById("uses")!.textContent = String(n); });
    </script>
  </body>
</html>
