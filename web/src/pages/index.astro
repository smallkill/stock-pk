---
import Base from "../layouts/Base.astro";
import StockSlots from "../components/StockSlots.astro";
import Results from "../components/Results.astro";
import { PRESETS } from "../lib/dates";
---
<Base>
  <section class="hero">
    <h1>台股多檔 <span class="pk">PK</span></h1>
    <p class="lede">選 2~5 檔台股、區間與金額,算每檔「含息」總報酬、互比差額、標出贏家,並畫成長曲線。</p>
  </section>

  <section class="panel">
    <div class="field-group">
      <label class="lbl">比較標的</label>
      <StockSlots />
    </div>

    <div class="field-group">
      <label class="lbl">區間</label>
      <div id="presets" class="presets">
        {PRESETS.map((p) => (
          <button type="button" class="preset" data-key={p.key}>{p.label}</button>
        ))}
      </div>
      <div class="dates">
        <label class="datefield">起<input type="date" id="from" /></label>
        <label class="datefield">訖<input type="date" id="to" /></label>
      </div>
    </div>

    <div class="field-group amount-row">
      <div>
        <label class="lbl" for="amount">投入金額(每檔)</label>
        <div class="amount-input">
          <span class="cur">NT$</span>
          <input type="number" id="amount" value="100000" min="1" step="1000" />
        </div>
      </div>
      <div class="actions">
        <button id="clear" type="button" class="clear">清除</button>
        <button id="run" type="button" class="run">計算 PK →</button>
      </div>
    </div>
  </section>

  <Results />
</Base>

<style>
  .hero{margin:2.4rem 0 1.6rem}
  .hero h1{font-size:2.1rem;font-weight:800;margin:0 0 .4rem;letter-spacing:-1px}
  .hero h1 .pk{color:var(--accent)}
  .lede{margin:0;color:var(--ink-soft);max-width:52ch}

  .panel{
    border:1px solid var(--line);border-radius:18px;background:var(--bg-elev);
    padding:1.4rem;display:flex;flex-direction:column;gap:1.4rem;
  }
  .field-group{display:flex;flex-direction:column;gap:.55rem}
  .lbl{font-size:.82rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}

  .presets{display:flex;flex-wrap:wrap;gap:.45rem}
  .preset{
    padding:.4rem .8rem;border:1px solid var(--line);border-radius:999px;background:var(--bg);
    color:var(--ink-soft);font-family:var(--sans);font-size:.85rem;cursor:pointer;
  }
  .preset:hover{border-color:var(--accent);color:var(--accent)}
  .preset.active{background:var(--accent);border-color:var(--accent);color:#fff}

  .dates{display:flex;gap:.8rem;flex-wrap:wrap}
  .datefield{display:flex;align-items:center;gap:.4rem;font-size:.85rem;color:var(--muted)}
  .datefield input{
    padding:.5rem .6rem;border:1px solid var(--line);border-radius:9px;background:var(--bg);
    font-family:var(--mono);font-size:.85rem;color:var(--ink);
  }
  .datefield input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}

  .amount-row{flex-direction:row;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:1rem}
  .amount-input{display:flex;align-items:center;gap:.4rem;border:1px solid var(--line);border-radius:10px;background:var(--bg);padding:.1rem .7rem;width:fit-content}
  .amount-input .cur{font-family:var(--mono);font-size:.8rem;color:var(--muted)}
  .amount-input input{border:none;background:transparent;padding:.55rem .2rem;width:9rem;font-family:var(--mono);font-size:1rem;color:var(--ink)}
  .amount-input input:focus{outline:none}
  .amount-input:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}

  .run{
    padding:.75rem 1.4rem;border:none;border-radius:11px;background:var(--accent);color:#fff;
    font-family:var(--sans);font-weight:700;font-size:1rem;cursor:pointer;
  }
  .run:hover{filter:brightness(1.05)}
  .run:disabled{opacity:.6;cursor:progress}

  .actions{display:flex;align-items:center;gap:.6rem}
  .clear{
    padding:.75rem 1.1rem;border:1px solid var(--line);border-radius:11px;background:var(--bg);color:var(--ink-soft);
    font-family:var(--sans);font-weight:600;font-size:.92rem;cursor:pointer;
  }
  .clear:hover{border-color:var(--accent);color:var(--accent)}

  @media (max-width:560px){
    .hero h1{font-size:1.7rem}
    .amount-row{flex-direction:column;align-items:stretch}
    .amount-input input{width:100%}
    .actions{width:100%}
    .run{flex:1}
  }
</style>

<script>
  import { presetRange, clampEnd, validRange, toYmd, detailRange, DETAIL_RANGES } from "../lib/dates";
  import { computeCompare, normalizeSplits, type SeriesInput, type CompareResult } from "../lib/compare";
  import { COLORS, renderChartSvg, renderPriceSvg, fmtPrice, type ChartLine } from "../lib/chart";
  import { fetchCompare, shortenUrl } from "../lib/api";
  import { initSlots, getSelectedTickers, getSelectedNames } from "../lib/slots-ui";
  import { encodeState, parseState, type ShareState } from "../lib/share";

  // ----- 元素 -----
  const fromEl = document.getElementById("from") as HTMLInputElement;
  const toEl = document.getElementById("to") as HTMLInputElement;
  const amountEl = document.getElementById("amount") as HTMLInputElement;
  const runEl = document.getElementById("run") as HTMLButtonElement;
  const clearEl = document.getElementById("clear") as HTMLButtonElement;
  const presetsEl = document.getElementById("presets")!;
  const resultsEl = document.getElementById("results") as HTMLElement;
  const cardsEl = document.getElementById("cards")!;
  const detailEl = document.getElementById("detail") as HTMLElement;
  const chartTitleEl = document.getElementById("chart-title") as HTMLElement;
  const chartEl = document.getElementById("chart")!;
  const noteEl = document.getElementById("note")!;

  // ----- 清除:回到乾淨首頁(清掉網址查詢、所有選取與結果)-----
  clearEl.addEventListener("click", () => {
    location.href = location.pathname;
  });

  // ----- 槽位:於 bootstrap()(檔末)依網址狀態初始化 -----

  // ----- 格式化工具 -----
  const fmtMoney = (n: number): string =>
    "NT$" + Math.round(n).toLocaleString("en-US");
  const fmtPct = (n: number): string => {
    const v = n * 100;
    const s = (v >= 0 ? "+" : "") + v.toFixed(2) + "%";
    return s;
  };
  const fmtSignedMoney = (n: number): string =>
    (n >= 0 ? "+" : "−") + "NT$" + Math.round(Math.abs(n)).toLocaleString("en-US");

  // ----- 區間快捷鈕 -----
  function setActivePreset(key: string | null): void {
    presetsEl.querySelectorAll<HTMLButtonElement>(".preset").forEach((b) => {
      b.classList.toggle("active", b.dataset.key === key);
    });
  }
  presetsEl.querySelectorAll<HTMLButtonElement>(".preset").forEach((btn) => {
    btn.addEventListener("click", () => {
      const key = btn.dataset.key!;
      const { from, to } = presetRange(key, Date.now());
      fromEl.value = toYmd(from);
      toEl.value = toYmd(to);
      setActivePreset(key);
    });
  });
  // 自訂日期改動 → 取消快捷高亮
  fromEl.addEventListener("input", () => setActivePreset(null));
  toEl.addEventListener("input", () => setActivePreset(null));

  // 預設帶入 1 年(bootstrap 在無分享狀態時呼叫)
  function applyDefaultRange(): void {
    const { from, to } = presetRange("1y", Date.now());
    fromEl.value = toYmd(from);
    toEl.value = toYmd(to);
    setActivePreset("1y");
  }

  // ----- 狀態:最近一次的 series + 金額,供前端切換基準重算 -----
  let lastSeries: SeriesInput[] | null = null;
  let lastAmount = 0;
  let baseTicker = "";
  // 單檔股價展開:目前展開的 ticker(null=關閉)、共同區間、hover 解綁。
  let openTicker: string | null = null;
  let lastResult: CompareResult | null = null;
  let detachDetailHover: (() => void) | null = null;
  let detailReq = 0;  // 競態保護:每次切區間 +1,慢回應的舊請求作廢
  const detailCache = new Map<string, SeriesInput>(); // key `ticker|fromYmd|toYmd` → 單檔序列
  let detailMode: "adj" | "close" = "adj";   // 含息還原價 / 原始股價(除息),session 內記住
  // 目前 detail 顯示中的序列(供切模式免重抓重畫)
  let detailCurrent: { color: string; days: number[]; adj: number[]; close: number[] } | null = null;
  let detailBox: HTMLElement | null = null;  // detail 圖容器
  let detailSub: HTMLElement | null = null;  // detail 副標(顯示模式 + 區間)
  let detachDetailDropdown: (() => void) | null = null; // 「更多」下拉的 outside-click 解綁
  const MORE_KEYS = ["1y", "5y", "max"];     // 收進「更多」下拉的區間

  // ----- 把目前比較狀態寫進網址(不重整)-----
  // 用 lastSeries 的 ticker(實際算出的標的)+ 目前表單日期/金額 + baseTicker。
  function syncUrl(): void {
    if (!lastSeries || lastSeries.length === 0) return;
    const state: ShareState = {
      tickers: lastSeries.map((s) => s.ticker),
      from: fromEl.value,
      to: toEl.value,
      amount: lastAmount,
      base: baseTicker,
    };
    history.replaceState(null, "", "?" + encodeState(state));
  }

  // ----- 提示訊息 -----
  function showNote(msg: string, kind: "err" | "warn" | "" = ""): void {
    noteEl.textContent = msg;
    noteEl.className = "note" + (kind ? " " + kind : "");
  }

  // ----- 卡片名稱對應(ticker → 顯示名,從 series 取)-----
  function nameFor(ticker: string): string {
    const s = lastSeries?.find((x) => x.ticker === ticker);
    return s?.name ?? ticker;
  }

  // ----- 日期格式(unix 秒 → YYYY/MM/DD,UTC)-----
  const fmtDate = (sec: number): string => toYmd(sec * 1000).replace(/-/g, "/");

  // ----- hover:垂直游標線 + tooltip(資料存於閉包,文字一律 textContent)-----
  // render() 每次重畫(含切換基準)都會重設 chartEl.innerHTML;listener 綁在持久的
  // chartEl 上不會被清掉,故先移除上次掛的,避免重複累積 + 參考到已被換掉的 cursor/tip。
  let detachHover: (() => void) | null = null;

  function attachHover(
    container: HTMLElement,
    lines: ChartLine[],
    days: number[],
    pointX: number[],
    amount: number,
  ): void {
    detachHover?.();
    detachHover = null;
    if (pointX.length === 0) return;

    const cursor = document.createElement("div");
    cursor.className = "cursor";
    cursor.hidden = true;
    const tip = document.createElement("div");
    tip.className = "tip";
    tip.hidden = true;
    container.append(cursor, tip);

    const svgEl = container.querySelector("svg");
    const targetH = svgEl ? svgEl.clientHeight || 240 : 240;

    function nearestIndex(px: number): number {
      let best = 0;
      let bestD = Infinity;
      for (let i = 0; i < pointX.length; i++) {
        const d = Math.abs(pointX[i] - px);
        if (d < bestD) { bestD = d; best = i; }
      }
      return best;
    }

    const onMove = (ev: MouseEvent): void => {
      const rect = container.getBoundingClientRect();
      const px = ev.clientX - rect.left;
      const idx = nearestIndex(px);
      const cx = pointX[idx];

      cursor.hidden = false;
      cursor.style.left = cx + "px";
      cursor.style.height = targetH + "px";

      // tooltip 內容
      tip.replaceChildren();
      const dateLn = document.createElement("div");
      dateLn.className = "tip-date";
      dateLn.textContent = fmtDate(days[idx]);
      tip.appendChild(dateLn);

      for (const l of lines) {
        const v = l.growth[idx];
        if (v === undefined) continue;
        const pct = amount === 0 ? 0 : (v / amount - 1) * 100;
        const row = document.createElement("div");
        row.className = "tip-row";
        const dot = document.createElement("span");
        dot.className = "dot";
        dot.style.background = l.color;
        const nm = document.createElement("span");
        nm.className = "tip-nm";
        nm.textContent = l.name;
        const val = document.createElement("span");
        val.className = "tip-val";
        val.textContent = `${fmtMoney(v)}(${(pct >= 0 ? "+" : "") + pct.toFixed(1)}%)`;
        row.append(dot, nm, val);
        tip.appendChild(row);
      }

      tip.hidden = false;
      // 定位:預設在游標右側,若超出右緣則翻到左側。
      const tw = tip.offsetWidth;
      let tipX = cx + 12;
      if (tipX + tw > rect.width) tipX = cx - 12 - tw;
      if (tipX < 0) tipX = 0;
      tip.style.left = tipX + "px";
      tip.style.top = "8px";
    };

    const onLeave = (): void => {
      cursor.hidden = true;
      tip.hidden = true;
    };

    container.addEventListener("mousemove", onMove);
    container.addEventListener("mouseleave", onLeave);

    detachHover = () => {
      container.removeEventListener("mousemove", onMove);
      container.removeEventListener("mouseleave", onLeave);
      cursor.remove();
      tip.remove();
    };
  }

  // ----- 單檔股價展開面板 -----
  // 關閉並清空 detail 面板。
  function closeDetail(): void {
    detachDetailHover?.();
    detachDetailHover = null;
    detachDetailDropdown?.();
    detachDetailDropdown = null;
    openTicker = null;
    detailCurrent = null;
    detailBox = null;
    detailSub = null;
    detailEl.replaceChildren();
    detailEl.hidden = true;
    detailEl.style.borderColor = "";   // 清掉上次的股色身分
    detailEl.style.background = "";
    clearActiveCards();
  }

  // 移除所有卡片的展開高亮(class + inline 股色邊框)。
  function clearActiveCards(): void {
    cardsEl.querySelectorAll<HTMLElement>(".card.detailopen").forEach((c) => {
      c.classList.remove("detailopen");
      c.style.borderColor = "";
    });
  }

  // detail 圖的 hover:垂直游標 + tooltip(日期 + 股價)。
  function attachPriceHover(
    box: HTMLElement, days: number[], prices: number[], pointX: number[],
  ): void {
    detachDetailHover?.();
    detachDetailHover = null;
    if (pointX.length === 0) return;

    const cursor = document.createElement("div");
    cursor.className = "cursor"; cursor.hidden = true;
    const tip = document.createElement("div");
    tip.className = "tip"; tip.hidden = true;
    box.append(cursor, tip);
    const svgEl = box.querySelector("svg");
    const targetH = svgEl ? svgEl.clientHeight || 220 : 220;

    const nearest = (px: number): number => {
      let best = 0, bestD = Infinity;
      for (let i = 0; i < pointX.length; i++) {
        const d = Math.abs(pointX[i] - px);
        if (d < bestD) { bestD = d; best = i; }
      }
      return best;
    };

    const onMove = (ev: MouseEvent): void => {
      const rect = box.getBoundingClientRect();
      const idx = nearest(ev.clientX - rect.left);
      const cx = pointX[idx];
      cursor.hidden = false;
      cursor.style.left = cx + "px";
      cursor.style.height = targetH + "px";
      tip.replaceChildren();
      const dl = document.createElement("div");
      dl.className = "tip-date";
      dl.textContent = fmtDate(days[idx]);
      const vl = document.createElement("div");
      vl.className = "tip-val";
      vl.textContent = "NT$" + fmtPrice(prices[idx]);
      tip.append(dl, vl);
      tip.hidden = false;
      const tw = tip.offsetWidth;
      let tipX = cx + 12;
      if (tipX + tw > rect.width) tipX = cx - 12 - tw;
      if (tipX < 0) tipX = 0;
      tip.style.left = tipX + "px";
      tip.style.top = "8px";
    };
    const onLeave = (): void => { cursor.hidden = true; tip.hidden = true; };
    box.addEventListener("mousemove", onMove);
    box.addEventListener("mouseleave", onLeave);
    detachDetailHover = () => {
      box.removeEventListener("mousemove", onMove);
      box.removeEventListener("mouseleave", onLeave);
      cursor.remove(); tip.remove();
    };
  }

  const modeLabel = (): string => (detailMode === "adj" ? "含息還原價" : "原始股價");

  // 依目前 detailCurrent + detailMode 畫圖(切模式時免重抓直接重畫)。
  function drawDetail(): void {
    if (!detailCurrent || !detailBox || !detailSub) return;
    detachDetailHover?.();
    detachDetailHover = null;
    const { days, color } = detailCurrent;
    const prices = detailMode === "adj" ? detailCurrent.adj : detailCurrent.close;
    if (days.length === 0 || prices.length === 0) {
      detailBox.replaceChildren();
      const empty = document.createElement("p");
      empty.className = "dsub"; empty.textContent = "此區間無資料。";
      detailBox.appendChild(empty);
      detailSub.textContent = modeLabel();
      return;
    }
    const w = detailEl.clientWidth || 700;
    const { svg, pointX } = renderPriceSvg(days, prices, color, w, 220);
    detailBox.innerHTML = svg;
    attachPriceHover(detailBox, days, prices, pointX);
    const span = `${fmtDate(days[0])}–${fmtDate(days[days.length - 1])}`;
    // 原始股價會在除權息/拆股當天跳空(真實掛牌價),提示一下免得被誤會成資料壞掉。
    detailSub.textContent = detailMode === "close"
      ? `原始股價 · ${span} · 除權息/拆股會跳空`
      : `含息還原價 · ${span}`;
  }

  // 設定 detail 區間的高亮:inline 鈕 + 「更多」鈕(選到下拉項時 label 變該項)。
  function setActiveRange(key: string | null): void {
    const ranges = detailEl.querySelector(".dranges");
    if (!ranges) return;
    ranges.querySelectorAll<HTMLButtonElement>(".drbtn[data-range]").forEach((b) => {
      b.classList.toggle("active", b.dataset.range === key);
    });
    const moreBtn = ranges.querySelector<HTMLButtonElement>(".dmorebtn");
    if (moreBtn) {
      const picked = key && MORE_KEYS.includes(key) ? DETAIL_RANGES.find((r) => r.key === key) : null;
      moreBtn.textContent = (picked ? picked.label : "更多") + " ▾";
      moreBtn.classList.toggle("active", !!picked);
    }
  }

  // 選某個區間:單獨重抓這檔的資料(超出比較區間也能看),重畫。競態保護 + cache。
  async function selectDetailRange(ticker: string, color: string, key: string): Promise<void> {
    const myReq = ++detailReq;
    setActiveRange(key);

    const now = Date.now();
    const { from, to } = detailRange(key, now);
    const toClamped = clampEnd(to, now);
    const fromSec = Math.floor(from / 1000);
    const toSec = Math.floor(toClamped / 1000);
    // cache key 用「日」粒度(toSec 含 now 毫秒會每次不同→永遠 miss);歷史日線同一天資料相同。
    const cacheKey = `${ticker}|${toYmd(from)}|${toYmd(toClamped)}`;

    let series = detailCache.get(cacheKey) ?? null;
    if (!series) {
      if (detailSub) detailSub.textContent = "讀取中…";
      try {
        const got = await fetchCompare([ticker], fromSec, toSec);
        if (got[0]) {
          got[0].adj = normalizeSplits(got[0].adj);
          series = got[0];
          // 上限 60 筆,超過淘汰最舊(Map 保留插入序);防長壽分頁無限成長。
          if (detailCache.size >= 60) { const oldest = detailCache.keys().next().value; if (oldest) detailCache.delete(oldest); }
          detailCache.set(cacheKey, got[0]);
        }
      } catch { series = null; }
    }
    // 期間若使用者又切了別的區間 / 關了面板 / 換了檔 → 此回應作廢
    if (myReq !== detailReq || openTicker !== ticker) return;

    if (!series) {
      detachDetailHover?.(); detachDetailHover = null;
      detailBox?.replaceChildren();
      if (detailBox) {
        const err = document.createElement("p");
        err.className = "dsub"; err.textContent = "讀取失敗,請稍後再試。";
        detailBox.appendChild(err);
      }
      if (detailSub) detailSub.textContent = modeLabel();
      return;
    }

    let days = series.days, adj = series.adj, close = series.close ?? series.adj;
    if (key === "5d") { days = days.slice(-5); adj = adj.slice(-5); close = close.slice(-5); }
    detailCurrent = { color, days, adj, close };
    drawDetail();
  }

  // 關閉「更多」下拉。
  function closeDropdown(): void {
    detachDetailDropdown?.();
    detachDetailDropdown = null;
    detailEl.querySelector(".dmenu")?.setAttribute("hidden", "");
  }

  // 渲染某檔的展開面板(預設顯示比較共同區間;區間選擇器 inline+更多下拉;含息/原始切換)。
  function renderDetail(ticker: string): void {
    if (!lastSeries || !lastResult) return;
    const s = lastSeries.find((x) => x.ticker === ticker);
    if (!s) return;
    const idx = lastResult.stocks.findIndex((x) => x.ticker === ticker);
    const color = COLORS[(idx < 0 ? 0 : idx) % COLORS.length];

    // 預設:截比較共同區間 [from,to](用已抓資料,免重抓),adj+close 都備好
    const days: number[] = [], adj: number[] = [], close: number[] = [];
    const srcClose = s.close ?? s.adj;
    for (let i = 0; i < s.days.length; i++) {
      if (s.days[i] >= lastResult.from && s.days[i] <= lastResult.to) {
        days.push(s.days[i]); adj.push(s.adj[i]); close.push(srcClose[i]);
      }
    }

    detachDetailHover?.();
    detachDetailHover = null;
    detachDetailDropdown?.();
    detachDetailDropdown = null;
    detailReq++;   // 作廢任何進行中的舊區間請求
    detailEl.replaceChildren();
    detailEl.hidden = false;
    // 用該股顏色當身分:色框 + 淡底(色碼後綴 "14" ≈ 8% alpha),與下面中性的比較圖區隔。
    detailEl.style.borderColor = color;
    detailEl.style.background = color + "14";

    // 指向被點開卡片的小三角(left 於下方對齊卡片中心)
    const pointer = document.createElement("div");
    pointer.className = "dpointer";
    pointer.style.borderBottomColor = color;
    detailEl.appendChild(pointer);

    // 標頭:eyebrow + 色塊 + 股名 ……（右)收起
    const head = document.createElement("div");
    head.className = "dhead";
    const eyebrow = document.createElement("span");
    eyebrow.className = "deyebrow"; eyebrow.textContent = "單檔股價";
    eyebrow.style.background = color;
    const sw = document.createElement("span");
    sw.className = "dswatch"; sw.style.background = color;
    const nm = document.createElement("span");
    nm.className = "dnm"; nm.textContent = s.name;
    const closeBtn = document.createElement("button");
    closeBtn.type = "button"; closeBtn.className = "dclose"; closeBtn.textContent = "收起 ✕";
    closeBtn.addEventListener("click", () => closeDetail());
    head.append(eyebrow, sw, nm, closeBtn);

    // 控制列:左=區間(inline + 更多下拉),右=含息/原始切換
    const controls = document.createElement("div");
    controls.className = "dcontrols";

    const ranges = document.createElement("div");
    ranges.className = "dranges";
    const mkRangeBtn = (key: string, label: string, cls: string): HTMLButtonElement => {
      const btn = document.createElement("button");
      btn.type = "button"; btn.className = cls; btn.dataset.range = key; btn.textContent = label;
      btn.addEventListener("click", () => { closeDropdown(); void selectDetailRange(ticker, color, key); });
      return btn;
    };
    for (const r of DETAIL_RANGES.filter((x) => !MORE_KEYS.includes(x.key))) {
      ranges.appendChild(mkRangeBtn(r.key, r.label, "drbtn"));
    }
    // 「更多 ▾」下拉
    const moreWrap = document.createElement("div");
    moreWrap.className = "dmore";
    const moreBtn = document.createElement("button");
    moreBtn.type = "button"; moreBtn.className = "drbtn dmorebtn"; moreBtn.textContent = "更多 ▾";
    const menu = document.createElement("div");
    menu.className = "dmenu"; menu.hidden = true;
    for (const r of DETAIL_RANGES.filter((x) => MORE_KEYS.includes(x.key))) {
      menu.appendChild(mkRangeBtn(r.key, r.label, "dmenuitem drbtn"));
    }
    moreBtn.addEventListener("click", () => {
      if (!menu.hidden) { closeDropdown(); return; }
      menu.hidden = false;
      // 點面板外 → 關閉下拉
      const onDoc = (ev: MouseEvent): void => { if (!moreWrap.contains(ev.target as Node)) closeDropdown(); };
      document.addEventListener("mousedown", onDoc);
      detachDetailDropdown = () => document.removeEventListener("mousedown", onDoc);
    });
    moreWrap.append(moreBtn, menu);
    ranges.appendChild(moreWrap);

    // 含息/原始 切換
    const mode = document.createElement("div");
    mode.className = "dmode";
    ([["adj", "含息還原價"], ["close", "原始股價"]] as const).forEach(([m, label]) => {
      const mb = document.createElement("button");
      mb.type = "button"; mb.className = "dmbtn"; mb.dataset.mode = m; mb.textContent = label;
      mb.classList.toggle("active", detailMode === m);
      mb.addEventListener("click", () => {
        if (detailMode === m) return;
        detailMode = m;
        mode.querySelectorAll<HTMLButtonElement>(".dmbtn").forEach((x) => {
          x.classList.toggle("active", x.dataset.mode === m);
        });
        drawDetail();   // 免重抓,直接換陣列重畫
      });
      mode.appendChild(mb);
    });

    controls.append(ranges, mode);

    const sub = document.createElement("div");
    sub.className = "dsub";

    const box = document.createElement("div");
    box.className = "dbox";

    detailEl.append(head, controls, sub, box);
    detailBox = box;
    detailSub = sub;

    // 三角對齊被點卡片的水平中心(相對 detail 面板),夾在面板內避免超出。
    const activeCard = cardsEl.querySelector<HTMLElement>(
      `.card[data-ticker="${CSS.escape(ticker)}"]`,
    );
    if (activeCard) {
      activeCard.style.borderColor = color;   // 卡片高亮邊框配股色,與面板/三角同色
      const cr = activeCard.getBoundingClientRect();
      const dr = detailEl.getBoundingClientRect();
      const cx = cr.left + cr.width / 2 - dr.left;
      const clamped = Math.max(12, Math.min(cx - 9, dr.width - 30));
      pointer.style.left = clamped + "px";
    } else {
      pointer.style.left = "24px";
    }

    // 預設畫比較區間(免重抓);不高亮任何區間鈕(=比較區間)
    detailCurrent = { color, days, adj, close };
    setActiveRange(null);
    drawDetail();
  }

  // 切換某檔展開(點同一檔=收起)。
  function toggleDetail(ticker: string): void {
    if (openTicker === ticker) { closeDetail(); return; }
    openTicker = ticker;
    clearActiveCards();
    // ticker 含 "."(如 0050.TW),CSS 選擇器要 escape,否則 . 被當 class 選擇器而選不到。
    cardsEl.querySelector(`.card[data-ticker="${CSS.escape(ticker)}"]`)?.classList.add("detailopen");
    renderDetail(ticker);
    detailEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  // ----- 渲染卡片 + 圖(用目前 baseTicker)-----
  function render(result: CompareResult): void {
    lastResult = result;
    closeDetail();          // 卡片即將重建,先收起單檔展開(避免指到舊 DOM)
    cardsEl.replaceChildren();
    detachHover?.();        // 移除上次 hover listener(replaceChildren 只清 DOM 不清 listener)
    detachHover = null;
    chartEl.replaceChildren();

    if (!result.overlap || result.stocks.length === 0) {
      chartTitleEl.hidden = true;
      showNote("所選股票在共同區間沒有重疊資料,請換股票或拉長區間。", "warn");
      return;
    }
    chartTitleEl.hidden = false;

    // 卡片(順序固定:依 lastSeries 的順序,讓顏色與圖一致)
    const order = result.stocks;
    order.forEach((s, i) => {
      const color = COLORS[i % COLORS.length];
      const card = document.createElement("div");
      card.className = "card";
      card.dataset.ticker = s.ticker;
      card.setAttribute("role", "button");
      card.setAttribute("tabindex", "0");
      card.title = "點擊看含息還原價走勢";
      if (s.ticker === result.winner) card.classList.add("win");
      if (s.ticker === baseTicker) card.classList.add("isbase");

      const swatch = document.createElement("span");
      swatch.className = "swatch";
      swatch.style.background = color;

      const nm = document.createElement("div");
      nm.className = "nm";
      const nmText = document.createElement("span");
      nmText.textContent = s.name;
      nm.appendChild(nmText);
      if (s.ticker === result.winner) {
        const crown = document.createElement("span");
        crown.className = "crown";
        crown.textContent = "👑";
        nm.appendChild(crown);
      }

      const tk = document.createElement("div");
      tk.className = "tk";
      tk.textContent = s.ticker;

      const roi = document.createElement("div");
      roi.className = "roi " + (s.roi >= 0 ? "up" : "down");
      roi.textContent = fmtPct(s.roi);

      const finalLn = document.createElement("div");
      finalLn.className = "ln";
      const finalK = document.createElement("span");
      finalK.textContent = "期末";
      const finalV = document.createElement("span");
      finalV.className = "v";
      finalV.textContent = fmtMoney(s.final);
      finalLn.append(finalK, finalV);

      const diffLn = document.createElement("div");
      diffLn.className = "ln";
      const diffK = document.createElement("span");
      diffK.textContent = "vs 基準";
      const diffV = document.createElement("span");
      diffV.className = "v " + (s.diff >= 0 ? "up" : "down");
      if (s.ticker === baseTicker) {
        diffV.classList.remove("up", "down");
        diffV.textContent = "基準";
      } else {
        diffV.textContent = `${fmtSignedMoney(s.diff)}(${fmtPct(s.diffPct)})`;
      }
      diffLn.append(diffK, diffV);

      const baseBtn = document.createElement("button");
      baseBtn.type = "button";
      baseBtn.className = "basebtn";
      baseBtn.textContent = s.ticker === baseTicker ? "✓ 目前基準" : "設為基準";
      baseBtn.addEventListener("click", (e) => {
        e.stopPropagation();   // 不要觸發卡片的展開
        if (s.ticker === baseTicker || !lastSeries) return;
        baseTicker = s.ticker;
        render(computeCompare(lastSeries, lastAmount, baseTicker));
      });

      // 點卡片(非基準鈕)→ 展開/收起該檔股價走勢
      card.addEventListener("click", () => toggleDetail(s.ticker));
      card.addEventListener("keydown", (e) => {
        // 只處理卡片本身的按鍵;焦點在內層「設為基準」鈕時別跟著冒泡觸發(避免雙觸發)
        if (e.target !== card) return;
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); toggleDetail(s.ticker); }
      });

      card.append(swatch, nm, tk, roi, finalLn, diffLn, baseBtn);
      cardsEl.appendChild(card);
    });

    // 成長圖(SVG 自產字串,股名不進 SVG;以容器實際像素寬度畫,viewBox 1:1)
    const lines: ChartLine[] = order.map((s, i) => ({
      name: s.name,
      growth: s.growth,
      color: COLORS[i % COLORS.length],
    }));
    const w = chartEl.clientWidth || 700;
    const { svg, pointX } = renderChartSvg(lines, result.days, lastAmount, w, 240);
    chartEl.innerHTML = svg;

    // hover 游標線 + tooltip(均由 DOM API 建立,文字走 textContent,XSS-safe)
    attachHover(chartEl, lines, result.days, pointX, lastAmount);

    // 圖例(textContent,安全)
    const legend = document.createElement("div");
    legend.className = "legend";
    order.forEach((s, i) => {
      const lg = document.createElement("div");
      lg.className = "lg";
      const dot = document.createElement("span");
      dot.className = "dot";
      dot.style.background = COLORS[i % COLORS.length];
      const nm = document.createElement("span");
      nm.textContent = s.name;
      const mn = document.createElement("span");
      mn.className = "mn";
      mn.textContent = s.ticker;
      lg.append(dot, nm, mn);
      legend.appendChild(lg);
    });
    chartEl.appendChild(legend);

    // 網址即時反映目前比較(含基準切換)
    syncUrl();
    // 分享按鈕(計算成功才顯示)
    renderShareBtn();

    // 提示:區間調整
    const span = `${toYmd(result.from * 1000)} ~ ${toYmd(result.to * 1000)}`;
    if (result.adjusted) {
      showNote(`資料以各檔共同重疊區間對齊計算:${span}。`, "warn");
    } else {
      showNote(`計算區間:${span}。`, "");
    }
  }

  // ----- 複製分享連結按鈕(放在結果區 chart 之後)-----
  const shareBtn = document.createElement("button");
  shareBtn.type = "button";
  shareBtn.id = "share";
  shareBtn.className = "sharebtn";
  shareBtn.textContent = "🔗 複製分享連結";
  const SHARE_LABEL = "🔗 複製分享連結";
  let shareResetTimer: number | undefined;
  shareBtn.addEventListener("click", async () => {
    shareBtn.disabled = true;
    shareBtn.textContent = "產生短網址…";
    const short = await shortenUrl(location.href); // 走 devbox 短網址服務
    const text = short ?? location.href;           // 失敗就用長網址
    try {
      await navigator.clipboard.writeText(text);
      shareBtn.textContent = short ? "已複製短網址 ✓" : "已複製長網址 ✓";
    } catch {
      // clipboard 不可用 → 顯示出來讓使用者手動複製
      showNote("分享連結:" + text);
      shareBtn.textContent = SHARE_LABEL;
    }
    shareBtn.disabled = false;
    window.clearTimeout(shareResetTimer);
    shareResetTimer = window.setTimeout(() => { shareBtn.textContent = SHARE_LABEL; }, 2200);
  });
  function renderShareBtn(): void {
    // 置於 chart 之後、note 之前;若已在 DOM 不重複插入。
    if (shareBtn.parentElement) return;
    chartEl.insertAdjacentElement("afterend", shareBtn);
  }

  // ----- 計算流程 -----
  // preferredBase:網址分享帶入的基準 ticker(僅首次自動計算用);一般點計算傳 null。
  async function runCompare(preferredBase: string | null = null): Promise<void> {
    const tickers = getSelectedTickers();
    if (tickers.length < 2) {
      resultsEl.hidden = false;
      closeDetail();
      chartTitleEl.hidden = true;
      cardsEl.replaceChildren();
      chartEl.replaceChildren();
      showNote("請至少選 2 檔股票(需從候選清單點選,不可只打字)。", "err");
      return;
    }

    const fromMs = fromEl.value ? Date.parse(fromEl.value + "T00:00:00Z") : NaN;
    const toMsRaw = toEl.value ? Date.parse(toEl.value + "T00:00:00Z") : NaN;
    if (!Number.isFinite(fromMs) || !Number.isFinite(toMsRaw)) {
      resultsEl.hidden = false;
      showNote("請選擇起訖日期。", "err");
      return;
    }
    const toMs = clampEnd(toMsRaw, Date.now());
    const v = validRange(fromMs, toMs);
    if (!v.ok) {
      resultsEl.hidden = false;
      showNote("起始日必須早於結束日。", "err");
      return;
    }

    const amount = Number(amountEl.value);
    if (!Number.isFinite(amount) || amount <= 0) {
      resultsEl.hidden = false;
      showNote("請輸入大於 0 的金額。", "err");
      return;
    }

    const fromSec = Math.floor(fromMs / 1000);
    const toSec = Math.floor(toMs / 1000);

    resultsEl.hidden = false;
    runEl.disabled = true;
    runEl.textContent = "計算中…";
    showNote("讀取股價資料中…", "");
    closeDetail();
    chartTitleEl.hidden = true;
    cardsEl.replaceChildren();
    chartEl.replaceChildren();

    try {
      const series = await fetchCompare(tickers, fromSec, toSec);
      // 修正 Yahoo 漏調的拆股(如 0052 2025-11 約 7:1),避免跨拆股點報酬全錯。
      for (const s of series) s.adj = normalizeSplits(s.adj);
      // 用使用者選的中文名覆蓋 Yahoo 英文名(找不到才保留 Yahoo 名)。
      const zhNames = getSelectedNames();
      for (const s of series) s.name = zhNames[s.ticker] ?? s.name;
      lastSeries = series;
      lastAmount = amount;
      // 基準:優先用 preferredBase(網址帶入且仍在算出清單內),否則 0050,否則第一檔
      const prefer = preferredBase && series.some((s) => s.ticker === preferredBase)
        ? preferredBase
        : null;
      const fav = series.find((s) => s.ticker.startsWith("0050."));
      baseTicker = prefer ?? (fav ? fav.ticker : series[0]?.ticker ?? "");
      const result = computeCompare(series, amount, baseTicker);
      // 「最久」算完後,把起日欄位更新成實際共同最早日(而非顯示 sentinel 1990),
      // 也讓接著 render→syncUrl 寫進網址的是真實日期。設 .value 不觸發 input 事件,最久高亮保留。
      const maxBtn = presetsEl.querySelector<HTMLButtonElement>('.preset[data-key="max"]');
      if (maxBtn?.classList.contains("active") && result.overlap) {
        fromEl.value = toYmd(result.from * 1000);
      }
      render(result);
    } catch (e) {
      const code = e instanceof Error ? e.message : "unknown";
      const friendly =
        code === "no_data"
          ? "找不到其中一檔的股價資料,請確認標的或換個區間。"
          : code === "bad_ticker" || code === "bad_request"
            ? "輸入有誤,請重新選擇標的與區間。"
            : "讀取失敗,請稍後再試(可能是網路或服務忙碌)。";
      showNote(friendly, "err");
    } finally {
      runEl.disabled = false;
      runEl.textContent = "計算 PK →";
    }
  }

  runEl.addEventListener("click", () => { void runCompare(); });

  // ----- 啟動:依網址狀態決定預填 + 自動計算 -----
  async function bootstrap(): Promise<void> {
    const st = parseState(new URLSearchParams(location.search));
    if (st) {
      // 槽位:把 ticker(2330.TW)去後綴轉成 code(2330)再傳入
      await initSlots("#slots", "#add", st.tickers.map((t) => t.split(".")[0]));
      // 日期:網址有就填,否則回退預設 1 年
      if (st.from && st.to) {
        fromEl.value = st.from;
        toEl.value = st.to;
        setActivePreset(null);
      } else {
        applyDefaultRange();
      }
      // 金額
      amountEl.value = String(st.amount);
      // 自動計算(基準用網址帶入的 b)
      void runCompare(st.base);
    } else {
      await initSlots("#slots", "#add");
      applyDefaultRange();
    }
  }
  void bootstrap();
</script>
